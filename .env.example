# Runtime
NODE_ENV=development
MELODAY_DATABASE_PATH=./data/meloday.sqlite
MELODAY_MEDIA_DIR=./data/media
MELODAY_PROVIDER_MODE=fake
MELODAY_SESSION_TTL_HOURS=24
MELODAY_GENERATION_TIMEOUT_MS=180000
MELODAY_GENERATION_MAX_CONCURRENT=2
MELODAY_GENERATION_QUEUE_LIMIT=20

# Set to real in production. Never expose these values to the browser.
TOKENHUB_API_KEY=
TOKENHUB_BASE_URL=https://tokenhub.tencentmaas.com/v1
TOKENHUB_TEXT_MODEL=deepseek/deepseek-flash
TOKENHUB_MUSIC_MODEL=minimax-music-v3.0
TOKENHUB_IMAGE_MODEL=seedream-image-v5.0-lite
# Used only by the protected capacity grant command.
MELODAY_ADMIN_TOKEN=change-me
